<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 installer for TruClip VST3 Plugin.

  Build with:
    wix build installer\truclip.wxs \
      -d "ProductVersion=<version>" \
      -d "VST3Dir=build\VST3\Release\truclip.vst3" \
      -o truclip-<version>-windows.msi

  Installs truclip.vst3 to:
    C:\Program Files\Common Files\VST3\truclip.vst3\Contents\x86_64-win\
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="TruClip VST3 Plugin"
    Manufacturer="TruClip Audio"
    Version="$(var.ProductVersion)"
    UpgradeCode="{E1F2A3B4-C5D6-E7F8-A9B0-C1D2E3F4A5B6}"
    Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <!-- Silently replace any older installation of the same product. -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of TruClip is already installed." />

    <!-- Add/Remove Programs metadata -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/gs06ahm/truclip" />
    <Property Id="ARPNOMODIFY"     Value="1" />

    <Feature Id="ProductFeature" Title="TruClip VST3 Plugin" Level="1">
      <ComponentRef Id="TruClipVST3Component" />
    </Feature>

  </Package>

  <!--
    Directory layout inside C:\Program Files\Common Files\VST3\
    mirrors the VST3 bundle structure that Ableton Live expects:

      truclip.vst3\
        Contents\
          x86_64-win\
            truclip.vst3   (the actual DLL)
  -->
  <Fragment>
    <StandardDirectory Id="CommonFilesFolder">
      <Directory Id="VST3DIR" Name="VST3">
        <Directory Id="TruClipBundleDir" Name="truclip.vst3">
          <Directory Id="ContentsDir" Name="Contents">
            <Directory Id="ArchDir" Name="x86_64-win">
              <Component
                Id="TruClipVST3Component"
                Guid="{B1C2D3E4-F5A6-B7C8-D9E0-F1A2B3C4D5E6}">
                <File
                  Id="TruClipVST3DLL"
                  Source="$(var.VST3Dir)\Contents\x86_64-win\truclip.vst3"
                  KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Fragment>

</Wix>
